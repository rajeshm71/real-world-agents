# Copy this file to .env and fill in the key(s) for whichever provider(s)
# you want to use. .env is gitignored -- never commit real keys.
#
# You only need ONE of the three provider keys below, matching whichever
# LLM_PROVIDER you set. No key is needed at all for development, tests, or
# CI -- everything runs under LLM_PROVIDER=mock by default in those contexts.

# --- Provider selection ---
# Which provider real (non-mock) calls use. Every agent defaults to
# "openai" if this is unset. Set to "mock" to force canned responses with
# no network calls and no key required (this is what CI always uses).
LLM_PROVIDER=openai

# --- Provider API keys (only the one matching LLM_PROVIDER is required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional: override the default model for a provider ---
# Every agent has a sensible per-provider default (see common/llm.py's
# DEFAULT_MODELS). Uncomment and set any of these to use a different model
# without touching code -- e.g. bump OpenAI up to gpt-5.4-mini for harder
# documents, or pin a different Anthropic/Gemini snapshot.
# OPENAI_DEFAULT_MODEL=gpt-4.1-mini-2025-04-14
# OPENAI_DEFAULT_MODEL=gpt-5.4-mini-2026-03-17
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash
